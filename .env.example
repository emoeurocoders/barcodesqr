# --- Database (Neon) ------------------------------------------------------
# Pooled connection for the app; the direct one is used by drizzle-kit for
# migrations, because the pooler rejects some DDL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Auth.js --------------------------------------------------------------
# Signs session cookies. Generate with:  openssl rand -base64 32
# Use a DIFFERENT value in each environment; rotating it signs everyone out.
AUTH_SECRET=

# --- Google sign-in ("Continue with Google") -------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials -> the OAuth
# 2.0 Client ID (type: Web application). The client must list, per
# environment, the EXACT redirect URI:
#
#   {origin}/api/auth/callback/google
#   e.g. http://localhost:3000/api/auth/callback/google  (dev)
#        https://barcodesqr.vercel.app/api/auth/callback/google
#
# When unset, the Google provider is not registered and the button reports
# that Google sign-in is unavailable — fine for local dev.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Designer asset sync (scripts/sync-design.mjs) -------------------------
# The designer's staging host is behind HTTP basic auth. Copy this file to
# `.env.local`, fill in the values, then run `npm run sync:design` to pull the
# latest HTML/CSS/JS/images into `html_files/`.
#
# Only needed by whoever ports the design; the app itself never reads these.
DESIGN_BASE_URL=https://storbuz.com/alpha/barcodes/BarcodesQR/
DESIGN_HTTP_USER=
DESIGN_HTTP_PASSWORD=

# --- Email delivery (Resend) ----------------------------------------------
# Sends the passwordless sign-in link behind the Log In modal. Without these
# three, "Continue with Email" cannot deliver anything and says so rather
# than pretending it sent.
#
# RESEND_API_KEY   From https://resend.com/api-keys — starts "re_".
# EMAIL_FROM       Sender address. The DOMAIN must be verified in Resend
#                  first (Domains -> Add Domain -> DNS records), or Resend
#                  rejects the send. e.g. BarcodesQR <hello@barcodesqr.com>
#                  For a quick local test, Resend accepts
#                  onboarding@resend.dev as a sender with no setup.
# APP_URL          Canonical origin the sign-in link points at, no trailing
#                  slash. Deliberately NOT taken from the request's Host
#                  header: an attacker who can set Host could otherwise aim
#                  the link — and the token in it — at their own domain.
#                  e.g. http://localhost:3000 locally.
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=

# --- Crisp live chat ----------------------------------------------------------
# Powers the footer "Live Help" link. Find the id in Crisp -> Settings ->
# Website Settings -> Setup instructions (the CRISP_WEBSITE_ID uuid).
#
# Public by design (it ships to the browser). When unset, the widget never
# loads and "Live Help" is a no-op — fine for local dev. The black colour theme
# and the hidden launcher bubble are configured in code, not the dashboard.
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# --- File storage (Cloudflare R2) -----------------------------------------
# Holds everything a visitor uploads in the creator: PDFs, images, video,
# audio and the per-link logos. R2 speaks the S3 API, so any S3-compatible
# host works if the endpoint and path style are set to match.
#
# The browser uploads straight to the bucket using a short-lived signed URL
# from /api/uploads — the bytes never pass through the app, because a
# serverless request body is capped at 4.5 MB on Vercel and the creator
# accepts a 50 MB video.
#
# Two things must be configured on the bucket itself, in the Cloudflare
# dashboard, or uploads fail in ways the app cannot fix:
#
#   1. CORS (R2 -> bucket -> Settings -> CORS policy): allow PUT and the
#      content-type header from each origin the app runs on.
#   2. Public access, so a scanned code can actually open the file.
#
# STORAGE_ENDPOINT           Account S3 endpoint, WITHOUT the bucket name:
#                            https://<account-id>.r2.cloudflarestorage.com
# STORAGE_BUCKET             Bucket name, e.g. barcodesqr
# STORAGE_ACCESS_KEY_ID      R2 API token with Object Read & Write on it.
# STORAGE_SECRET_ACCESS_KEY  Shown once when the token is created.
# STORAGE_REGION             R2 ignores it, the S3 signer requires it: auto
# STORAGE_PUBLIC_BASE_URL    Origin files are READ from, no trailing slash.
#                            Not the endpoint above — that one is private.
#                            The r2.dev address works for development, but
#                            Cloudflare rate-limits it and does not support
#                            it for production; attach a custom domain
#                            before launch and change this one value.
# STORAGE_FORCE_PATH_STYLE   false for R2 (bucket is a subdomain). true for
#                            MinIO/localstack style hosts.
#
# Verify a bucket end to end — credentials, read, write, CORS, public read —
# with:  npm run storage:check
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=false
