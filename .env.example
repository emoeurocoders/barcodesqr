# --- Designer asset sync (scripts/sync-design.mjs) -------------------------
# The designer's staging host is behind HTTP basic auth. Copy this file to
# `.env.local`, fill in the values, then run `npm run sync:design` to pull the
# latest HTML/CSS/JS/images into `html_files/`.
#
# Only needed by whoever ports the design; the app itself never reads these.
DESIGN_BASE_URL=https://storbuz.com/alpha/barcodes/BarcodesQR/
DESIGN_HTTP_USER=
DESIGN_HTTP_PASSWORD=
